{
  "name": "url_safe-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extension url_safe : analyse d’URL locale, avec actualisation facultative des listes.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "build:firefox": "node scripts/build.mjs --target firefox --release",
    "icons": "python3 scripts/make-icons.py",
    "data": "cd .. && python3 -m app.export_datasets",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
